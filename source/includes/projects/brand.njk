{# Bohemica Studio logo variants (opened from the logomark in the hero) #}
<h1 class="sr-only">{{ t.projectPages.brand.title }}</h1>
<div class="flex flex-col md:flex-row">
	<div class="flex w-full flex-col items-start space-y-12 rounded-3xl p-6 md:w-1/2 lg:p-12">
		<img class="h-32" src="/images/brand/symbol-colour.svg" alt="Bohemica Studio symbol – colour">
		<img class="h-24" src="/images/brand/logo-full-colour.svg" alt="Bohemica Studio logo – colour">
		<img class="h-24" src="/images/brand/logo-full-grey.svg" alt="Bohemica Studio logo – grey">
		<img class="h-48" src="/images/brand/logo-text-vertical-grey.svg" alt="Bohemica Studio vertical logo – grey">
	</div>
	<div class="flex w-full flex-col items-start space-y-12 rounded-3xl bg-black p-6 md:w-1/2 lg:p-12">
		<img class="h-32" src="/images/brand/symbol-white.svg" alt="Bohemica Studio symbol – white">
		<img class="h-24" src="/images/brand/logo-full-white.svg" alt="Bohemica Studio logo – white">
		<img class="h-24" src="/images/brand/logo-full-grey.svg" alt="Bohemica Studio logo – grey">
		<img class="h-48" src="/images/brand/logo-text-vertical-grey.svg" alt="Bohemica Studio vertical logo – grey">
	</div>
</div>
