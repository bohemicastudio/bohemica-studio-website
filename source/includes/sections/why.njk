{# Full-screen "Why" panel. Clicking "Why" in a menu hides the other sections, so the five panels follow each other. #}
{% macro sectionWhy(name, number, bgClass='bg-blue-400', iconClass='text-blue-400', outline='white') %}
	{% set outlineText = 'text-white' if outline == 'white' else 'text-black' %}
	{% set outlineBorder = 'border-white' if outline == 'white' else 'border-black' %}
	<section id="why-{{ name }}" class="{{ bgClass }}" aria-label="{{ t.sections.why.title }} {{ number }}">
		<div class="site-container">
			<div class="relative overflow-hidden">
				<div class="flex h-screen flex-col justify-start md:h-screen-125">
					<div class="flex h-screen items-center">
						<div class="flex w-full flex-col" :style="$store.ui.onlyWhy ? 'padding-top: 8rem' : 'padding-bottom: calc((0.25vw + 0.5vh + 0.25vmax) * 20)'" style="padding-bottom: calc((0.25vw + 0.5vh + 0.25vmax) * 20)">
							<div class="flex items-center justify-center self-center rounded-lg border-2 px-2.5 py-1 font-optician-sans text-xl md:hidden {{ outlineText }} {{ outlineBorder }}">
								<span>{{ number }}</span>
							</div>
							<div class="hidden flex-row items-center justify-center md:flex">
								<hr class="w-full border-t border-b {{ outlineBorder }}">
								<div class="rounded-full border-2 p-5 {{ iconClass }} {{ outlineBorder }}">
									<svg style="width: 50px; height: 50px" xmlns="http://www.w3.org/2000/svg" viewBox="{{ {'one': '0 0 44 50', 'two': '0 0 32 50', 'three': '0 0 40 50', 'four': '0 0 37 50', 'five': '0 0 40 50'}[name] }}" fill="currentColor" stroke="{{ outline }}" aria-hidden="true">{% include "icons/why-" + name + ".svg" %}</svg>
								</div>
								<hr class="w-full border-t border-b {{ outlineBorder }}">
							</div>
							<p class="mx-auto mt-10 mb-12 text-center font-optician-sans text-2xl tracking-wide md:mt-14 md:mb-20 md:w-10/12 md:text-2.25xl xl:text-2.5xl {{ outlineText }}">{{ t.why[name] | safe }}</p>
							<hr class="hidden w-full border-t border-b md:flex {{ outlineBorder }}">
						</div>
					</div>
				</div>
				<div x-show="!$store.ui.onlyWhy" class="absolute inset-x-0 bottom-0 hidden h-1/2 translate-y-1/2 pb-[100%] md:flex" style="background-image: radial-gradient(circle, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0) 50%);"></div>
			</div>
		</div>
	</section>
{% endmacro %}
