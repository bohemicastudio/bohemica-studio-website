{% from "components/buttons.njk" import buttonProject with context %}
{% from "components/badge-feature.njk" import badgeFeature with context %}
{% from "components/project-meta.njk" import projectMeta with context %}

{# Project teaser in the "What" section: 3D preview + key facts #}
{% macro projectExample(key, imageSize='50', reverse=false, badges=[]) %}
	<article class="flex flex-col space-y-8 py-8 md:space-y-0 md:py-16 {{ 'md:flex-row-reverse' if reverse else 'md:flex-row' }}">
		<div class="relative flex w-full items-center justify-center md:w-1/2">
			<img src="/images/project/{{ key }}/preview-3d.png" alt="{{ t.projects.list[key].client }} – {{ t.projects.list[key].type }}" id="preview-image-{{ key }}" class="mx-auto w-auto" style="max-height: calc((0.25vw + 0.5vh + 0.25vmin) * {{ imageSize }})" data-zoom eleventy:widths="400,800" sizes="(min-width: 960px) 40vw, 90vw">
		</div>
		<div class="flex w-full items-center justify-start md:w-1/2 md:justify-center">
			<div class="flex flex-col items-start space-y-10">
				{% if badges | length %}
					<div class="flex flex-row space-x-4">
						{% for badge in badges %}
							{{ badgeFeature(name=badge.name, icon=badge.icon, link=badge.link) }}
						{% endfor %}
					</div>
				{% endif %}
				<h4 class="sr-only">{{ t.projects.list[key].client }} – {{ t.projects.list[key].type }}</h4>
				{{ projectMeta(key, dark=true) }}
				{{ buttonProject(key) }}
			</div>
		</div>
	</article>
{% endmacro %}
