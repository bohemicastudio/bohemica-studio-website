{% from "components/buttons.njk" import buttonProject, buttonLink with context %}

{# `logo` is a path under /images (without it, the company name is shown); `project` links to a case study, `link` to another website #}
{% macro testimonial(key, logo=none, logoHeight=16, quoteClass='text-blue-300', project=none, link=none) %}
	{% set data = t.sectionWho.testimonials[key] %}
	<figure class="flex flex-col items-start">
		<div class="h-16">
			{% if logo %}
			<img alt="{{ data.company }}" style="height: {{ logoHeight / 4 }}rem" src="/images/{{ logo }}" eleventy:widths="320,640" sizes="320px">
			{% else %}
			<p class="text-2xl leading-none font-bold tracking-tight text-cool-gray-700">{{ data.company }}</p>
			{% endif %}
		</div>
		<blockquote class="relative mt-12 mb-10">
			<p class="relative z-10 font-dm-mono text-base leading-relaxed font-medium text-cool-gray-800 sm:text-lg md:text-xl md:leading-relaxed md:font-normal">{{ data.review }}</p>
			<svg class="absolute top-0 right-0 z-0 -translate-y-1/2 {{ quoteClass }}" width="77" height="48" viewBox="0 0 77 48" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">{% include "icons/quote.svg" %}</svg>
		</blockquote>
		<figcaption class="ml-auto grid grid-cols-2 gap-x-4">
			<div class="flex items-center justify-end">
				<hr class="w-12 border-cool-gray-600">
			</div>
			<div>
				<span class="font-bold text-cool-gray-600 sm:whitespace-nowrap">{{ data.company }}</span>
			</div>
			<div></div>
			<div class="flex flex-col items-start">
				{% if data.country %}<span class="text-sm font-medium text-cool-gray-500">{{ data.country }}</span>{% endif %}
				{% if data.url %}<span class="mt-3 text-sm break-all text-cool-gray-500">{{ data.url | safe }}</span>{% endif %}
			</div>
		</figcaption>
		{% if project %}
		<div class="mt-12">
			{{ buttonProject(project, offsetClass='focus:ring-offset-white') }}
		</div>
		{% elif link %}
		<div class="mt-12">
			{{ buttonLink(link, t.ui.visitSignage, offsetClass='focus:ring-offset-white') }}
		</div>
		{% endif %}
	</figure>
{% endmacro %}
