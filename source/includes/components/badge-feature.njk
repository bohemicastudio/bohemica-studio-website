{% macro badgeFeature(name, icon='official-partner.svg', link=false) %}
	{% if link %}
		<a rel="noopener" href="{{ link }}" target="_blank" class="not-prose inline-flex flex-row space-x-2 rounded-xl bg-amber-400 px-3.5 py-1.5">
	{% else %}
		<div class="not-prose inline-flex flex-row space-x-2 rounded-xl bg-amber-400 px-3.5 py-1.5 select-none">
	{% endif %}
		<img alt="" src="/images/badge/{{ icon }}" width="20" height="20">
		<span class="font-dm-sans text-sm font-medium tracking-normal whitespace-nowrap text-warm-gray-700">{{ t.badge[name] }}</span>
	{% if link %}</a>{% else %}</div>{% endif %}
{% endmacro %}
