{# Rounded heading box that opens each main section #}
{% macro sectionIntro(name, boxClass='bg-gray-legacy-800', titleClass='text-blue-400', subtitleClass='text-blue-200', lineClass='border-gray-legacy-200', subtitle=true) %}
	<div id="{{ name }}-intro" class="relative mx-auto w-full -translate-y-1/3 md:container-screen md:w-8/12 md:-translate-y-1/2">
		<div class="flex flex-col items-center justify-center rounded-4xl text-center {{ boxClass }}">
			<div class="space-y-4 px-6 pt-10 pb-6 md:space-y-8 md:px-16 md:pt-16 md:pb-12">
				<h2 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl {{ titleClass }}">{{ t.sections[name].title }}</h2>
				{% if subtitle and t.sections[name].subtitle %}
					<p class="font-dm-mono leading-7 lg:text-lg lg:leading-8 {{ subtitleClass }}">{{ t.sections[name].subtitle }}</p>
				{% endif %}
			</div>
			<div class="relative flex h-20 w-full grow justify-center md:h-28">
				<hr class="absolute border-t-0 border-l {{ lineClass }}" style="bottom: -100%; height: 200%">
			</div>
		</div>
	</div>
{% endmacro %}
