{# Icon + title (+ subtitle) block inside a section #}
{% macro sectionTitle(title, subtitle='', icon='process.svg', dark=true) %}
	<div class="mx-auto flex w-full flex-col items-center text-center md:w-8/12 lg:w-2/3">
		<img alt="" class="h-full" src="/images/icon/{{ icon }}" loading="lazy">
		<h3 class="mt-6 text-2.25xl font-medium md:text-3xl lg:text-4xl lg:leading-normal {{ 'text-cool-gray-800' if dark else 'text-cool-gray-200' }}">{{ title }}</h3>
		{% if subtitle %}
			<p class="mt-6 font-dm-mono leading-relaxed md:text-lg {{ 'text-cool-gray-700' if dark else 'text-cool-gray-300' }}">{{ subtitle }}</p>
		{% endif %}
	</div>
{% endmacro %}
