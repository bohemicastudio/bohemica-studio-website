{% from "components/buttons.njk" import buttonCall with context %}

{% macro processStep(step, chipClass='bg-cyan-500', imageTop='bubble', imageBottom='coffee') %}
	{% set data = t.processSteps[step] %}
	<div class="flex w-full flex-col bg-white p-5 sm:px-10 sm:py-8 md:w-10/12 md:py-20 md:pl-14">
		<div class="relative">
			<img alt="" src="/images/step/{{ imageTop }}.png" class="absolute top-0 right-0 hidden h-64 translate-x-1/2 translate-y-6 md:block" eleventy:widths="256,512" sizes="256px">
			<img alt="" src="/images/step/{{ imageBottom }}.png" class="absolute right-0 bottom-0 hidden h-40 translate-x-full translate-y-6 md:block" eleventy:widths="160,320" sizes="160px">
			<span class="text-sm font-bold tracking-wider text-cool-gray-900 uppercase">{{ t.processSteps.step }} {{ step }}</span>
			<h4 class="mt-4 text-4xl text-cool-gray-700 sm:text-5xl md:text-7xl">{{ data.title }}</h4>
			{% if step == 1 %}
				{{ buttonCall(classes='text-warm-gray-800 focus:ring-offset-white focus:ring-yellow-400') }}
			{% endif %}
			<div class="prose mt-10 w-full md:mt-16 md:w-9/12">
				<ul class="font-dm-mono text-base text-cool-gray-900 [&>li+li]:mt-12">
					{% for row in data.description %}
						<li>{{ row }}</li>
					{% endfor %}
				</ul>
			</div>
			<ul class="mt-12 flex flex-wrap gap-2 md:mt-24 md:gap-x-3">
				{% for keyword in data.keywords %}
					<li class="rounded-full px-2.5 py-1 text-sm font-medium whitespace-nowrap text-white select-none {{ chipClass }}">{{ keyword }}</li>
				{% endfor %}
			</ul>
		</div>
	</div>
{% endmacro %}
