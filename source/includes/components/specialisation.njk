{% macro specialisation(name, image, order='00', titleClass='text-orange-200', chipClass='bg-orange-700') %}
	<img alt="" class="origin-bottom-left scale-75 md:scale-100" src="/images/specialisation/{{ image }}" loading="lazy">
	<h3 class="mt-4 text-sm font-bold tracking-widest uppercase md:mt-6 md:text-base {{ titleClass }}">{{ order }} // {{ t.specialisation[name].title }}</h3>
	<p class="mt-4 mb-4 text-2xl font-medium text-white md:mt-10 md:mb-6 md:text-4xl">{{ t.specialisation[name].subtitle }}</p>
	<ul class="flex flex-wrap gap-2 md:gap-x-3">
		{% for keyword in t.specialisation[name].keywords %}
			<li class="rounded-full px-2.5 py-1 text-sm font-medium whitespace-nowrap text-white select-none {{ chipClass }}">{{ keyword }}</li>
		{% endfor %}
	</ul>
{% endmacro %}
