{# GitHub repository card - data is fetched at build time (data/repos.js) #}
{% macro gitCard(repo) %}
	<a href="{{ repo.url }}" target="_blank" rel="noopener" class="flex grow flex-col justify-start space-y-3 rounded-lg border border-blue-gray-500 p-4 transition duration-100 ease-linear hover:border-blue-gray-300">
		<span class="flex flex-row items-center space-x-3">
			<span class="relative h-16 w-16 shrink-0 overflow-hidden rounded-md">
				<img alt="" class="absolute h-16 w-16 object-cover" src="{{ repo.avatar }}" width="64" height="64" loading="lazy" decoding="async" eleventy:ignore>
			</span>
			<span class="text-lg">
				<span class="text-cool-gray-100">{{ repo.owner }}</span>
				<span class="text-cool-gray-100">/</span>
				<span class="font-medium text-white">{{ repo.name }}</span>
			</span>
		</span>
		<span class="flex grow flex-col justify-start leading-relaxed text-blue-gray-200">{{ repo.description }}</span>
		<span class="flex flex-row space-x-8 font-dm-mono text-sm font-medium tracking-wide">
			{% if repo.language %}
				<span class="flex flex-row items-center space-x-2">
					<i class="block h-2.5 w-2.5 rounded-full {{ {'CSS': 'bg-purple-600', 'JavaScript': 'bg-yellow-500', 'TypeScript': 'bg-teal-600', 'Go': 'bg-cyan-500'}[repo.language] or 'bg-blue-gray-400' }}"></i>
					<span class="text-blue-gray-200">{{ repo.language }}</span>
				</span>
			{% endif %}
			<span class="flex flex-row items-center space-x-2">
				<svg class="w-4 text-blue-gray-400" width="26" height="24" viewBox="0 0 26 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-label="Stars">{% include "icons/star.svg" %}</svg>
				<span class="text-blue-gray-200">{{ repo.stars | compactNumber }}</span>
			</span>
			<span class="flex flex-row items-center space-x-2">
				<span class="w-2 text-blue-gray-400" aria-label="Forks">
					<i class="gg-git-fork"></i>
				</span>
				<span class="text-blue-gray-200">{{ repo.forks | compactNumber }}</span>
			</span>
		</span>
	</a>
{% endmacro %}
