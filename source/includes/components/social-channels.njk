{# LinkedIn icon link. `classes` sets colours, `tooltips` adds hover labels. #}
{% macro socialChannels(classes='text-blue-gray-500 hover:bg-blue-gray-300 hover:text-blue-gray-700', tooltips=false, tooltipPosition='') %}
	<a rel="noopener" href="{{ site.social.linkedin }}" target="_blank" aria-label="{{ t.ui.linkedin }}"{% if tooltips %} data-tooltip="{{ t.tooltip.linkedin }}"{% if tooltipPosition %} data-tooltip-position="{{ tooltipPosition }}"{% endif %}{% endif %} class="cursor-pointer rounded-full p-3.5 transition duration-150 ease-linear {{ classes }}">
		<span class="flex h-7 w-7 items-center justify-center">
			<svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 28 28" aria-hidden="true">{% include "icons/linkedin.svg" %}</svg>
		</span>
	</a>
{% endmacro %}
