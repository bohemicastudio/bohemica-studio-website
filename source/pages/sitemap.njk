---
permalink: /sitemap.xml
layout: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for entry in homePages %}{% if not entry.root %}
	<url>
		<loc>{{ entry.url | absoluteUrl(site.url) }}</loc>
		<lastmod>{{ site.updated }}</lastmod>
		{% for language in site.languages %}
		<xhtml:link rel="alternate" hreflang="{{ language.hreflang }}" href="{{ routes.home(language.code) | absoluteUrl(site.url) }}"/>
		{% endfor %}
		<xhtml:link rel="alternate" hreflang="x-default" href="{{ '/' | absoluteUrl(site.url) }}"/>
	</url>
{% endif %}{% endfor %}
{% for entry in projectPages.concat(privacyPages) %}
	<url>
		<loc>{{ entry.url | absoluteUrl(site.url) }}</loc>
		<lastmod>{{ site.updated }}</lastmod>
		{% for language in site.languages %}
		<xhtml:link rel="alternate" hreflang="{{ language.hreflang }}" href="{{ (routes[entry.page](language.code) if entry.page else routes.project(entry.key, language.code)) | absoluteUrl(site.url) }}"/>
		{% endfor %}
		<xhtml:link rel="alternate" hreflang="x-default" href="{{ (routes[entry.page]('en') if entry.page else routes.project(entry.key, 'en')) | absoluteUrl(site.url) }}"/>
	</url>
{% endfor %}
</urlset>
