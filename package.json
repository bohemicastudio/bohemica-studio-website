{
  "name": "bohemica-studio-website",
  "version": "1.0.0",
  "private": true,
  "description": "Bohemica Studio Website",
  "homepage": "https://www.bohemicastudio.com",
  "author": "Bohemica Studio",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "repos:snapshot": "node lib/repos.js"
  },
  "dependencies": {
    "alpinejs": "^3.17.5",
    "medium-zoom": "^1.1.2"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-fetch": "^6.0.1",
    "@11ty/eleventy-img": "^7.1.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp"
    ]
  }
}
